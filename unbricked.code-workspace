{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"chat.tools.terminal.autoApprove": {
			"pnpm": true,
			"q": true,
			"npx tsc": true,
			"npx eslint": true,
			"npx vitest": true,
			"npx vite": true,
			"/^\\./node_modules/\\.bin/vitest run$/": {
				"approve": true,
				"matchCommandLine": true
			},
			"/^\\./node_modules/\\.bin/vitest run 2>&1$/": {
				"approve": true,
				"matchCommandLine": true
			}
		}
	}
}